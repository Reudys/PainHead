@model PainHead.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<style>
    .ph-card {
        border:none;
        border-radius:20px;
        box-shadow:0 10px 25px rgba(0,0,0,.12);
    }

    .ph-header {
        background:#fff4ef;
        border-left:6px solid #FF6B35;
        border-radius:12px;
        padding:15px;
    }

    .form-control:focus {
        border-color:#34C759;
        box-shadow:0 0 0 .2rem rgba(52,199,89,.25);
    }

    .btn-save {
        background:#34C759;
        border-color:#34C759;
        color:white;
    }

    .btn-save:hover {
        background:#28a745;
        color:white;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card ph-card">
            <div class="card-body p-4">
                <h2 class="mb-2">✏️ Editar Producto</h2>
                <p class="text-muted mb-3">
                    Modifica la información del producto.
                </p>
                <div class="ph-header mb-3">
                    <strong>Producto ID:</strong> @Model.Id
                </div>
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold">
                            Nombre
                        </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-bold">
                            Descripción
                        </label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción opcional"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label fw-bold">
                            Precio
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">MX$</span>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-save btn-lg">
                            💾 Guardar Cambios
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}