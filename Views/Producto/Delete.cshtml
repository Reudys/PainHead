@model PainHead.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<style>
    .ph-card {
        border:none;
        border-radius:25px;
        box-shadow:0 12px 30px rgba(0,0,0,.12);
    }

    .ph-warning {
        background:#fff4ef;
        border-left:6px solid #FF6B35;
        border-radius:15px;
        padding:20px;
    }

    .ph-danger-card {
        border-top:6px solid #ff3b30;
    }

    .btn-delete {
        background:#ff3b30;
        border-color:#ff3b30;
        color:white;
    }

    .btn-delete:hover {
        background:#d9362e;
        color:white;
    }

</style>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card ph-card ph-danger-card">
            <div class="card-body p-4">
                <h2 class="mb-3">
                    🗑️ Eliminar Producto
                </h2>
                <div class="ph-warning mb-4">
                    <h5>
                        ⚠️ Confirmación requerida
                    </h5>
                    <p class="mb-0">
                        Estás a punto de eliminar este producto.
                        Esta acción no se puede deshacer.
                    </p>
                </div>
                    <div class="card mb-4">
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">
                                Producto
                            </dt>
                            <dd class="col-sm-8 fw-bold">
                                @Model.Nombre
                            </dd>
                            <dt class="col-sm-4">
                                Descripción
                            </dt>
                            <dd class="col-sm-8">
                                @(Model.Descripcion ?? "Sin descripción")
                            </dd>
                            <dt class="col-sm-4">
                                Precio
                            </dt>
                            <dd class="col-sm-8 text-success fw-bold">
                                MX$ @Model.Precio.ToString("N2")
                            </dd>
                        </dl>
                    </div>
                </div>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-delete btn-lg">
                        🗑️ Sí, eliminar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
</div>