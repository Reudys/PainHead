@model PainHead.Models.Producto

@{
    ViewData["Title"] = "Crear Nuevo Producto";
}



<style>
    .ph-title {
        font-weight:800;
        color:#000;
    }

    .ph-card {
        border:none;
        border-radius:25px;
        box-shadow:0 12px 30px rgba(0,0,0,.12);
    }

    .ph-header {
        background:#fff4ef;
        border-left:6px solid #FF6B35;
        border-radius:15px;
        padding:20px;
    }

    .form-control:focus {
        border-color:#34C759;
        box-shadow:0 0 0 .2rem rgba(52,199,89,.25);
    }

    .btn-save {
        background:#34C759;
        border-color:#34C759;
        color:white;
    }

    .btn-save:hover {
        background:#28a745;
        color:white;
    }
</style>

<div class="mb-4">
    <h2 class="ph-title">
        📦 Nuevo Producto
    </h2>
        <p class="text-muted">
            Agrega un producto al catálogo del negocio.
        </p>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card ph-card">
            <div class="card-body p-4">
                <div class="ph-header mb-4">
                    <h5 class="mb-1">
                        Información del producto
                    </h5>
                    <p class="mb-0 text-muted">
                        Completa los datos para registrar el producto.
                    </p>
                </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">
                        Nombre del producto
                    </label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Hamburguesa, Refresco..." />
                    <span asp-validation-for="Nombre"
                        class="text-danger">
                    </span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">
                        Descripción
                    </label>
                    <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Descripción opcional del producto"></textarea>
                    <span asp-validation-for="Descripcion"
                        class="text-danger">
                    </span>
                </div>
                <div class="mb-4">
                    <label asp-for="Precio" class="form-label fw-bold">
                        Precio 
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            MX$
                        </span>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Precio"
                        class="text-danger">
                    </span>
                </div>
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-save btn-lg">
                        💾 Guardar Producto
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}