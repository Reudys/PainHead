<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PainHead</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PainHead.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Logo + Nombre -->
                <div class="d-flex align-items-center">
                    <div class="logo me-3"></div>

                    <a class="navbar-brand m-0 bold"
                    asp-area=""
                    asp-controller="Mesa"
                    asp-action="Start">
                        PainHead
                    </a>
                </div>

                <!-- Botón responsive -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPainHead">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menú -->
                <div class="collapse navbar-collapse justify-content-end"
                    id="navbarPainHead">

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-controller="Mesa"
                            asp-action="Start">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-controller="Mesa"
                            asp-action="Index">
                                Mesas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-controller="Producto"
                            asp-action="Index">
                                Productos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-controller="Mesa"
                            asp-action="Jornada">
                                Jornadas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-controller="Mesa"
                            asp-action="ProductosVendidos">
                                Productos Vendidos
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-black">
        <div class="container text-white d-flex justify-content-end" title="Shhhh 🤫">
            &copy; 2026 - Mr. R
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
