@model PainHead.Models.Pedido

@{
    ViewData["Title"] = "Agregar Producto";
    var productos = ViewBag.Productos as List<PainHead.Models.Producto>;
}

<style>
    .ph-title {
        color: #000;
        font-weight: 700;
    }

    .ph-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, .10);
    }

    .ph-orange {
        background: #fff4ef;
        border-left: 6px solid #FF6B35;
        border-radius: 15px;
        padding: 20px;
    }

    .ph-label {
        font-weight: 600;
        color: #333;
    }

    .ph-optional {
        color: #6c757d;
        font-size: .85rem;
        font-weight: 400;
    }

    .ph-help {
        color: #6c757d;
        font-size: .85rem;
        margin-top: 6px;
    }

    .ph-specification {
        resize: vertical;
        min-height: 90px;
    }

    .ph-btn-success {
        background: #34C759;
        border-color: #34C759;
        color: white;
    }

    .ph-btn-success:hover {
        background: #2fb650;
        border-color: #2fb650;
        color: white;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="ph-title">
            🛒 Agregar Producto
        </h2>

        <p class="text-muted mb-0">
            Mesa @Model.Mesa?.NumeroMesa —
            Cliente: <strong>@Model.NombreCliente</strong>
        </p>
    </div>
</div>

<div class="ph-orange mb-4">
    <h5 class="mb-2">
        👤 @Model.NombreCliente
    </h5>

    <p class="mb-0 text-muted">
        Selecciona un producto, indica la cantidad y agrega una
        especificación si el cliente tiene alguna solicitud especial.
    </p>
</div>

<div class="card ph-card">
    <div class="card-body p-4">

        @if (productos != null && productos.Any())
        {
            <form asp-action="AddProducto" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="pedidoId"
                       value="@Model.Id" />

                <div class="mb-4">
                    <label class="form-label ph-label">
                        Producto
                    </label>

                    <select name="productoId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Selecciona un producto --
                        </option>

                        @foreach (var producto in productos)
                        {
                            <option value="@producto.Id">
                                @producto.Nombre -
                                MX$ @producto.Precio.ToString("N2")
                            </option>
                        }

                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label ph-label">
                        Cantidad
                    </label>

                    <input type="number"
                           name="cantidad"
                           value="1"
                           min="1"
                           class="form-control"
                           required />
                </div>

                <div class="mb-4">
                    <label class="form-label ph-label">
                        Especificación
                        <span class="ph-optional">
                            (opcional)
                        </span>
                    </label>

                    <textarea name="especificacion"
                              class="form-control ph-specification"
                              maxlength="250"
                              placeholder="Ej.: Sin hielo, poco azúcar, bien cocido, sin cebolla..."></textarea>

                    <div class="ph-help">
                        📝 Puedes indicar cualquier detalle especial
                        solicitado por el cliente.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn ph-btn-success">
                        🛒 Agregar al Pedido
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.MesaId"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>
        }
        else
        {
            <div class="alert alert-warning mb-3">
                No hay productos registrados en el sistema.
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Producto"
                   asp-action="Create"
                   class="btn ph-btn-success">
                    + Crear Producto
                </a>

                <a asp-action="Details"
                   asp-route-id="@Model.MesaId"
                   class="btn btn-outline-secondary">
                    Volver a la Mesa
                </a>
            </div>
        }

    </div>
</div>