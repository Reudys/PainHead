@model IEnumerable<PainHead.Models.ProductoVendidoResumen>

@using System.Text.Json

@{
    var nombres = Model.Select(x => x.Nombre).ToList();
    var cantidades = Model.Select(x => x.CantidadVendida).ToList();
    var ingresos = Model.Select(x => x.Ingresos).ToList();

    var totalProductos = Model.Sum(x => x.CantidadVendida);
    var totalIngresos = Model.Sum(x => x.Ingresos);

    var masVendido = Model
        .OrderByDescending(x => x.CantidadVendida)
        .FirstOrDefault();

    var masRentable = Model
        .OrderByDescending(x => x.Ingresos)
        .FirstOrDefault();
}

<style>

    .ph-title {
        color: #000000;
        font-weight: 700;
    }

    .ph-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
    }

    .ph-card-green {
        border-top: 5px solid #34C759;
    }

    .ph-card-orange {
        border-top: 5px solid #FF6B35;
    }

    .ph-card h6 {
        color: #666;
        font-weight: 600;
    }

    .ph-card h3,
    .ph-card h5 {
        color: #000;
        font-weight: 700;
    }

    .ph-section-title {
        color: #FF6B35;
        font-weight: 700;
    }

    .table thead {
        background: #FF6B35;
        color: white;
    }

    .table tbody tr:hover {
        background: rgba(52,199,89,.08);
    }

</style>

<h2 class="mb-4 ph-title">
    Productos Vendidos
</h2>

<!-- TARJETAS RESUMEN -->

<div class="row mb-4">

    <div class="col-md-3 mb-3">
        <div class="card ph-card ph-card-green text-center">
            <div class="card-body">
                <h6>Total Productos Vendidos</h6>
                <h3>@totalProductos</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card ph-card ph-card-orange text-center">
            <div class="card-body">
                <h6>Producto Más Vendido</h6>
                <h5>@(masVendido?.Nombre ?? "-")</h5>
                <small>@(masVendido?.CantidadVendida ?? 0) unidades</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card ph-card ph-card-green text-center">
            <div class="card-body">
                <h6>Ingresos Totales</h6>
                <h3>MX$ @totalIngresos.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card ph-card ph-card-orange text-center">
            <div class="card-body">
                <h6>Producto Más Rentable</h6>
                <h5>@(masRentable?.Nombre ?? "-")</h5>
                <small>MX$ @(masRentable?.Ingresos.ToString("N2") ?? "0.00")</small>
            </div>
        </div>
    </div>

</div>

<!-- GRAFICOS -->

<div class="row">

    <div class="col-md-6">
        <div class="card ph-card mb-4">
            <div class="card-body">
                <h5 class="text-center mb-3 ph-section-title">
                    Participación por Cantidad Vendida
                </h5>

                <canvas id="chartCantidad"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card ph-card mb-4">
            <div class="card-body">
                <h5 class="text-center mb-3 ph-section-title">
                    Ingresos por Producto
                </h5>

                <canvas id="chartIngresos"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- TABLA -->

<div class="card ph-card">
    <div class="card-body">

        <h4 class="mb-3 ph-section-title">
            Detalle de Productos
        </h4>

        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad Vendida</th>
                    <th>Ingresos Generados</th>
                </tr>
            </thead>

            <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.CantidadVendida</td>
                    <td>MX$ @item.Ingresos.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const nombres = @Html.Raw(JsonSerializer.Serialize(nombres));
    const cantidades = @Html.Raw(JsonSerializer.Serialize(cantidades));
    const ingresos = @Html.Raw(JsonSerializer.Serialize(ingresos));

    // Paleta de colores profesional
    const paleta = [
        "#34C759",
        "#FF6B35",
        "#3B82F6",
        "#8B5CF6",
        "#EC4899",
        "#F59E0B",
        "#14B8A6",
        "#EF4444",
        "#6366F1",
        "#10B981",
        "#F97316",
        "#06B6D4",
        "#84CC16",
        "#A855F7",
        "#E11D48",
        "#0EA5E9",
        "#D946EF",
        "#22C55E",
        "#FB7185",
        "#FACC15",
        "#0F766E",
        "#DC2626",
        "#2563EB",
        "#7C3AED",
        "#EA580C",
        "#059669",
        "#0284C7",
        "#BE185D",
        "#65A30D",
        "#9333EA"
    ];

    // Genera un color para cada producto
    const colores = nombres.map((_, i) =>
        paleta[i % paleta.length]
    );

    // Colores con transparencia para las barras
    const coloresBarras = colores.map(color => color + "CC");

    // =====================
    // GRÁFICO DE PASTEL
    // =====================

    new Chart(document.getElementById('chartCantidad'), {

        type: 'pie',

        data: {
            labels: nombres,
            datasets: [{
                data: cantidades,
                backgroundColor: colores,
                borderColor: '#FFFFFF',
                borderWidth: 2
            }]
        },

        options: {
            responsive: true,

            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 15,
                        usePointStyle: true
                    }
                }
            }
        }
    });

    // =====================
    // GRÁFICO DE BARRAS
    // =====================

    new Chart(document.getElementById('chartIngresos'), {

        type: 'bar',

        data: {
            labels: nombres,
            datasets: [{
                label: 'Ingresos (MX$)',
                data: ingresos,
                backgroundColor: coloresBarras,
                borderColor: colores,
                borderWidth: 2,
                borderRadius: 8
            }]
        },

        options: {
            responsive: true,

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {

                x: {
                    ticks: {
                        maxRotation: 45,
                        minRotation: 45
                    }
                },

                y: {
                    beginAtZero: true
                }
            }
        }
    });

</script>