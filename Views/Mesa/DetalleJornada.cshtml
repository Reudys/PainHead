@model Jornada

@{
    ViewData["Title"] = $"Jornada #{Model.Id}";
}


<style>
    .ph-title {
        color:#000;
        font-weight:700;
    }

    .ph-card {
        border:none;
        border-radius:20px;
        box-shadow:0 10px 25px rgba(0,0,0,.10);
    }

    .ph-green {
        background:#34C759;
        color:white;
        border-radius:18px;
        padding:25px;
    }

    .ph-orange {

        background:#fff4ef;
        border-left:6px solid #FF6B35;
        border-radius:15px;
        padding:20px;
    }


    .table thead {
        background:#FF6B35;
        color:white;
    }


    .badge-active {
        background:#34C759;
        padding:8px 14px;
        border-radius:20px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="ph-title">
            📊 Jornada #@Model.Id
        </h2>
        <p class="text-muted mb-0">
            Resumen de ventas realizadas
        </p>
    </div>
    <div class="ph-green text-center">
        <small>
            TOTAL VENDIDO
        </small>
        <h2 class="mb-0">
            MX$ @Model.Ventas.Sum(v => v.Total).ToString("N2")
        </h2>
    </div>
</div>

<div class="ph-orange mb-4">
    <div class="row">
        <div class="col-md-6">
            <strong>
                🟢 Apertura:
            </strong>
            <br />
            @Model.FechaApertura
        </div>
        <div class="col-md-6">
            <strong>
                🔴 Cierre:
            </strong>
            <br />
            @(Model.FechaCierre?.ToString() ?? "Aún Abierta")
        </div>
    </div>
</div>
<div class="card ph-card">
    <div class="card-body p-4">
        <h4 class="mb-4">
            Ventas Registradas
        </h4>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>
                            Fecha
                        </th>
                        <th>
                            Mesa
                        </th>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Total
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var venta in Model.Ventas)
                    {
                        <tr>
                            <td>
                                @venta.FechaVenta
                            </td>
                            <td>
                                <span class="badge bg-success">
                                    Mesa @venta.NumeroMesa
                                </span>
                            </td>
                            <td>
                                @venta.NombreMesa
                            </td>
                            <td class="fw-bold">
                                MX$ @venta.Total.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>