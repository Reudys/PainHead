@model PainHead.Models.Jornada

@{
    ViewData["Title"] = $"Jornada #{Model.Id}";
}

<div class="card ph-card mt-4">

    <div class="card-body p-4">

        <h4 class="mb-4">
            🛒 Productos Vendidos
        </h4>

        @if (Model.Ventas.Any(v => v.ProductosVendidos.Any()))
        {
            @foreach (var venta in Model.Ventas)
            {
                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-header bg-orange text-white">

                        <div class="d-flex justify-content-between">

                            <strong>
                                Mesa @venta.NumeroMesa - @venta.NombreMesa
                            </strong>

                            <span>
                                @venta.FechaVenta.ToString("dd/MM/yyyy hh:mm tt")
                            </span>

                        </div>

                    </div>

                    <div class="card-body">

                        @if (venta.ProductosVendidos.Any())
                        {
                            <table class="table table-hover align-middle">

                                <thead>

                                    <tr>

                                        <th>Producto</th>

                                        <th>Cantidad</th>

                                        <th>Precio Unitario</th>

                                        <th>Subtotal</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var producto in venta.ProductosVendidos)
                                    {
                                        <tr>

                                            <td class="fw-semibold">
                                                @producto.NombreProducto
                                            </td>

                                            <td>
                                                @producto.Cantidad
                                            </td>

                                            <td>
                                                MX$ @producto.PrecioUnitario.ToString("N2")
                                            </td>

                                            <td class="text-success fw-bold">
                                                MX$ @producto.SubTotal.ToString("N2")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                Esta venta no tiene productos registrados.
                            </div>
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                No existen productos vendidos registrados para esta jornada.
            </div>
        }

    </div>

</div>